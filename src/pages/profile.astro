---
import Layout from '../layouts/astro/main.astro';
---
<Layout title='profile' desc='customise your profile'>

<div class="profile">
    <h1 id="profile/title">Hello,</h1>
    <div class="banner" id="profile/banner"/>

    <div class="content">
        <img class="pfp" src="" id="profile/pfp"/>
        <div class="about">
            <h3 id="profile/username" class="username"></h3>
            <p id="profile/pronouns" class="pronouns"></p>
            
            <hr>
            <p id="profile/bio" class="bio">
                IM A BIO
            </p>
            <p class="web">
                <a id="profile/web">
                    link
                </a>
            </p>
        </div>
    </div>
    <div id="profile/edit" class="edit">
        <h1>edit</h1>

        <!--edit/profile_picture-->
        <details>
            <summary>
                profile picture
            </summary>

            <form id="profile/pfp/form">
                <fieldset style="border: none;">
                    <label for="profilePictureUpload" id="profilePictureUploadDisplay" />
                    <input
                        id="profilePictureUpload"
                        type="file"
                        accept="image/*"
                        name="profile-file"
                    />
                    <input 
                        class="infoCardWrapper saveButton" 
                        id="profilePictureUploadButton" 
                        type="submit"
                        disabled
                    >
                </fieldset>
            </form>
        </details>

        <!--edit/banner-->
        <details>
            <summary>
                banner
            </summary>

            <form id="profile/banner/form">
                <fieldset style="border: none;">
                    <label for="profileBannerUpload" id="profileBannerUploadDisplay" />
                    <input
                        id="profileBannerUpload"
                        type="file"
                        accept="image/*"
                        name="profile-file"
                    />
                    <input 
                        class="infoCardWrapper saveButton" 
                        id="profileBannerUploadButton" 
                        type="submit"
                        disabled
                    >
                </fieldset>
            </form>
        </details>

        <!--edit/username-->
        <details>
            <summary>
                username
            </summary>

            <input
                class="infoCardWrapper saveButton"
                id="profile/username/input"
            >
            <button 
                class="infoCardWrapper saveButton" 
                id="profile/username/save" 
                disabled
            >
                
                save
            </button>
        </details>

        <!--edit/pronouns-->
        <details>
            <summary>
                pronouns
            </summary>

            <input
                class="infoCardWrapper saveButton"
                id="profile/pronouns/input"
            >
            <button 
                class="infoCardWrapper saveButton" 
                id="profile/pronouns/save" 
                disabled
            >
                
                save
            </button>
            <p>
                please input in the format of {"{pronoun}"}/{"{pronoun}"}/{"{pronoun}"}
            </p>
        </details>

        <!--edit/websiteLink-->
        <details>
            <summary>
                website
            </summary>

            <input
                class="infoCardWrapper saveButton"
                id="profile/website/input"
            >
            <button 
                class="infoCardWrapper saveButton" 
                id="profile/website/save" 
                disabled
            >
                
                save
            </button>
            <p>
                This is a link to your favourite social media or website, please nothing inappropriate. It is very difficult for me to poliece these
            </p>
        </details>

        <!--edit/bio-->
        <details>
            <summary>
                bio
            </summary>

            <input
                class="infoCardWrapper saveButton"
                id="profile/bio/input"
            >
            <button 
                class="infoCardWrapper saveButton" 
                id="profile/bio/save" 
                disabled
            >
                
                save
            </button>
        </details>

        <p>you will have to reload the page to see any changes, may take a while for the changes to show throughout the whole website</p>
    </div>
</div>

<script src="/src/res/js/api/profile.js"/>
</Layout>