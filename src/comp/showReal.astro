---
import showReel from '../res/videos/showReel.mp4'
---
<video class="showReel" width="320" height="240" controls>

    <source src="/videos/showReel.mp4" type="video/mp4">
    Your browser does not support the video tag.

    <style>
        .showReel {
            width: 60vw;
            height: 40vh;

            display: block;
            position: relative;
            
            margin: auto auto;

            // border
            border: 1px solid;
            border-bottom: 2px solid;
            border-radius: 7px;

            border-color: var(--TextBaseColor);

            // background
            opacity: 0.8;

            // effect
            .blur {width: 100%; height: 100%; backdrop-filter: blur(1px); transition: all ease-in-out 0.3s;}
            &:hover{
                // color
                opacity: 1;
                box-shadow: 2px 2px 5px 2.5px var(--TextBaseColor);
                //children
                .blur{backdrop-filter: blur(0px);}
            }

            transition: all ease-in-out 0.3s;
        }
    </style>
</video> 