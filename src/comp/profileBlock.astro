---
interface Props { socials : Array<Array<string>>; pfp : string; friends : Array<Array<string>>; }
const { socials = [], pfp = "", friends = []} = Astro.props;

console.log(socials);

/* socials is a 2d array, 
    position 0: website name
    position 1: website link
*/
---
<div class="profileBlock">
    <!--Base html-->
    <!------------->
    <img class="profileBlockPfp" src={pfp}/>
    <div class="profileBlockLinks">
        {socials.length > 0 ? <ul> {socials.map((social) => <li><a href={social[1]}>{social[0]}</a></li>)} </ul> : <p>empty</p>}
    </div>

    <h2 style="text-align: center; grid-column: 1 / 3;">---</h2>

    <div class="profileBlockMain">
        <mainText>
            <slot />
        </mainText>
        
        <div class="hld-88-31">
            {friends.length > 0 ? <div>{friends.map((fren) => <a href={fren[1]}><img class="m-88-31" src={fren[0]} /></a>)}</div> : <p>no friends</p>}
        </div>
    </div>    
    <!------------->
    <!--Style-->
    <!--------->
    <style lang="scss">
        .profileBlock {
            // positioning
            width: 90vw;
            height: auto;

            max-width: 1000px;

            margin: auto auto;
            margin-top: 5vh;

            padding-top: 2.5vh;
        
            // // coloring
            // background-color: rgba(10, 0, 5, 0.75);
            // backdrop-filter: blur(10px);

            // // border
            //     border: 1px solid;
            //     border-bottom: 2px solid;
            //     border-radius: 7px;

            //     border-color: var(--TextBaseColor);

            // grid

            display: grid;
            grid-template-columns: 50% 50%;

            // children
            .profileBlockMain {
                grid-column: 1 / 3;
                padding: 1vh;

                min-height: 50px;
            }
            .profileBlockPfp {
                // positioning
                max-width: 100px;
                min-height: 100px;

                border-radius: 50%;

                margin: auto auto;

                // border
                border: 1px solid;
                border-bottom: 3px solid;
                border-color: var(--TextBaseColor);

                // dev
                background-color: pink;
            }
            .profileBlockLinks {
                
            }

            maintext {
                width: auto !important;
            }

        }
    </style>
    <!--------->
    <!--Js-->
    <!------>
    <script>
        console.log("tada");
    </script>
    <!------>    
</div>