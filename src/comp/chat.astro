<div class="chatOutline" id="chatOutLine">
    <div id="chat_chat" />

    <br>

    <div style="display: grid; grid-template-columns: 75% 25%; width: 95%;margin:auto;">
        <input placeholder="name..." id="chat_nameBox" style="margin: 0; width: 99%">
        <button id="chat_sendButton"  style="margin: 0; width: 99%;">send message</button>
    </div>

    <div id="chatcontainer">
        <input placeholder="message..." id="chat_messageBox">
    </div>        
    <div class="bottomChat">

        <div class="config">
            <div class="chatConfig">
                <p>chat config: (speed, color, room)</p>

                <input type="number" id="chat_chatSpeed" min="100" max="2000" value=1000>
                <input value="#ffffff" type="color" id="chat_colorBox">
        
        
                <select name="endpoints" id="chat_chatNameBox">
                    <option value="">base chat</option>
                </select>
            </div>
            <hr class="mobile">
            <div class="confconf">
                <p>chat config: (speed, color, room)</p>
                <button id="clearRain"> clear rain </button>
            </div>
        </div>
    </div>
</div>