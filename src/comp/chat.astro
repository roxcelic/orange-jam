<div class="chatOutline" id="chatOutLine">
    <div id="chat_chat" />

    <br>

    <input placeholder="name..." id="chat_nameBox">

    <div id="chatcontainer">
        <input placeholder="message..." id="chat_messageBox">
    </div>

    <button id="chat_sendButton">send message</button>
    
    <hr>

    <p>chat config: (speed, color, room)</p>
    <div class="chatConfig">
        <input type="number" id="chat_chatSpeed" min="100" max="2000" value=1000>
        <input value="#ffffff" type="color" id="chat_colorBox">


        <select name="endpoints" id="chat_chatNameBox">
            <option value="">base chat</option>
        </select>
    </div>
</div>