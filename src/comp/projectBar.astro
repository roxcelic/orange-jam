---
interface Props { gameVideo: string; gameImage: string; title: string; downloadLink: string;}
const { gameVideo = "", gameImage, title, downloadLink = "" } = Astro.props;
---
<div class="projectBar">
    <!--Base html-->
    <!------------->
    <h1 style="text-align: center;">{title}</h1>
    <div style=`background-image: url('${gameImage}');` class="gameImage"><div class="blur"/></div>
    {gameVideo != "" ? <iframe src={gameVideo} width="640" height="480" allow="autoplay" class="gameVideo"><div class="blur"/></iframe>: <p></p>}
    {downloadLink != "" ? <p style="text-align: center; margin-bottom: -1vh;"><a href={downloadLink}>download</a></p> : <p></p>}
    <h2 style="text-align: center;">---</h2>
    <!------------->

    <!--Style-->
    <!--------->
    <style lang="scss">
        .projectBar {
            // positioning
            width: 100vw;

            // children
            .gameImage {
                // positioning
                position: relative;

                width: 60vw;
                height: 5vw;

                right: 0px;
                top: 0px;

                margin: auto auto;

                margin-top: 2.5vh;
                margin-bottom: 1vh;

                // background
                background-size: cover;
                background-position: center;
                opacity: 0.8;

                // border
                border: 1px solid;
                border-bottom: 2px solid;
                border-radius: 7px;

                border-color: var(--TextBaseColor);

                .blur {width: 100%; height: 100%; backdrop-filter: blur(1px); transition: all ease-in-out 0.3s;}
                &:hover{
                    //position
                    right: -5px;
                    top: -5px;
                    // color
                    opacity: 1;
                    box-shadow: 2px 2px 5px 2.5px var(--TextBaseColor);
                    //children
                    .blur{backdrop-filter: blur(0px);}
                }

                transition: all ease-in-out 0.3s;
            }

            .gameVideo {
                // positioning
                width: auto;
                min-width: 60vw;
                
                height: unset;
                min-height: 40vh;

                display: block;
                position: relative;
                
                margin: auto auto;

                // border
                border: 1px solid;
                border-bottom: 2px solid;
                border-radius: 7px;

                border-color: var(--TextBaseColor);

                // background
                opacity: 0.8;

                // effect
                .blur {width: 100%; height: 100%; backdrop-filter: blur(1px); transition: all ease-in-out 0.3s;}
                &:hover{
                    // color
                    opacity: 1;
                    box-shadow: 2px 2px 5px 2.5px var(--TextBaseColor);
                    //children
                    .blur{backdrop-filter: blur(0px);}
                }

                transition: all ease-in-out 0.3s;
            }
        }
    </style>
    <!--------->

    <!--Js-->
    <!------>
    <script>
        console.log("tada");
    </script>
    <!------>
</div>