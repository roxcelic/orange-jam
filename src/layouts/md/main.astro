---
const { frontmatter } = Astro.props;

import Layout from '../full.astro';
---

<Layout desc={frontmatter.desc} title={frontmatter.title} wallpaper={frontmatter.wallpaper}>
    <h1 id="title" style=`display: ${frontmatter.headingDisplay};`>{frontmatter.heading}</h1>
    <canvas id="banner" style=`background-image: url(${frontmatter.banner});display: ${frontmatter.bannerDisplay};` class="banner">
        
    </canvas>

    <div class="text">
        <slot />        
    </div>
</Layout>