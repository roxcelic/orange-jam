---
interface Props {
	title: string;
    desc: string;
}

const { desc } = Astro.props;
const { title } = Astro.props;

import '../res/scss/style.scss'

import Music from '../comp/music.astro';
import Nav from '../comp/nav.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={ desc }/>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/icon.svg">

        <link href="https://crimtane.roxcelic.love/styles.css" rel="stylesheet">
        
		<script src="../res/js/script"/>

		<meta name="generator" content={Astro.generator} />
		<title>{ title }</title>
	</head>
	<body>
		<div class="main">
			<Music />
			<div class="content">
				<Nav 
					title={ title }
					desc={ desc }
				/>
				<slot />
			</div>
		</div>
	</body>
</html>