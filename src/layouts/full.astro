---
interface Props {
	title: string;
    desc: string;
	wallpaper: string;
}

const { desc } = Astro.props;
const { title } = Astro.props;
const { wallpaper } = Astro.props;

import '../res/scss/style.scss'

import Titlebar from '../comp/titlebar.astro';
---

<!doctype html>
<html lang="en" style=`background-image: url(${wallpaper});`>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={ desc }/>
		<meta name="viewport" content="width=device-width" />

		<script src="../res/js/script"/>

		<!--font-->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=send" />
		<link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400..700&display=swap" rel="stylesheet">

		<!--astro-->
		<meta name="generator" content={Astro.generator} />
		<title>{ title }</title>
	</head>
	<body>
		<main>
			<Titlebar />
			<slot />			
		</main>
	</body>

</html>